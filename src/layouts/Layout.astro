---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AuthModal from '../components/AuthModal';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  current?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'Plokr gives engineering leaders real-time visibility into Jira progress and dependency health across every repo.',
  canonical,
  ogImage = '/og-default.png',
  current = '',
  noIndex = false,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:site_name" content="Plokr" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <!-- Security meta (belt-and-suspenders alongside HTTP headers) -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16.png" />
    <link rel="apple-touch-icon" href="/brand/plokr-icon-blue-256.png" />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- JSON-LD Organization (homepage only; other pages can add their own) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Plokr",
        "url": "https://plokr.com",
        "description": "Mission control for engineering — real-time Jira monitoring and dependency health.",
        "sameAs": []
      }
    </script>
  </head>
  <body class="mc">
    <Nav current={current} />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Auth modal (React island, always hydrated) -->
    <AuthModal client:load />

    <!-- Intercept data-auth buttons and open the React modal -->
    <script>
      document.addEventListener('click', (e: Event) => {
        const target = (e.target as HTMLElement).closest('[data-auth]') as HTMLElement | null;
        if (target) {
          e.preventDefault();
          const mode = target.dataset.auth ?? 'signup';
          window.dispatchEvent(new CustomEvent('plokr:open-auth', { detail: { mode } }));
        }
      });
    </script>
  </body>
</html>
