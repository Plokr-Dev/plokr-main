---
import Layout from '../layouts/Layout.astro';
import PricingTiers from '../components/PricingTiers';
import { PLOKR_APP, SITE_DESCRIPTION } from '../lib/constants';
import { Lock, Eye, ScanLine, ShieldCheck, GitBranch, Zap } from 'lucide-react';

const sparkBlue = [40, 55, 48, 70, 62, 80, 72, 90];
const sparkGreen = [88, 90, 86, 91, 89, 93, 91, 91];
---

<Layout
  title="Plokr — Mission control for engineering"
  description={SITE_DESCRIPTION}
  current="home"
>
  <!-- JSON-LD: SoftwareApplication -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Plokr",
    "applicationCategory": "DeveloperApplication",
    "offers": { "@type": "Offer", "price": "29", "priceCurrency": "USD" },
    "description": "Security scanning and dependency health for engineering teams."
  }
  </script>

  <!-- DUAL HERO: CORE + INTEGRATE -->
  <header class="hhero dual-hero">
    <div class="wrap">
      <!-- Core Hero (Left) -->
      <div class="hero-col">
        <span class="eyebrow">▮ PLOKR CORE</span>
        <h1>Find the risk. <em>Track</em> the fix.</h1>
        <p class="sub">Scan the dependencies in your repos and rank the risk by severity, so your team fixes what matters first.</p>
        <div class="cta">
          <a class="btn btn-primary btn-lg" href={PLOKR_APP} data-auth="signup">Start 7-day free trial</a>
        </div>
        <div class="trust">
          <span><b>Authorize-first</b> scanning</span>
          <span><b>Authorize-first</b> access</span>
        </div>
      </div>

      <!-- Core Panel -->
      <div class="panel" role="img" aria-label="Sample dashboard showing open findings and dependency health">
        <div class="ph">
          <span class="t">Overview (sample data)</span>
          <span class="live" aria-label="Sample data">SAMPLE</span>
        </div>
        <div class="pgrid">
          <div class="kpi">
            <div class="lab">Open findings</div>
            <div class="num">14<small>-3</small></div>
            <div class="spark" aria-hidden="true">
              {sparkBlue.map((h) => <i style={`height:${h}%`}></i>)}
            </div>
          </div>
          <div class="kpi">
            <div class="lab">Dependency health</div>
            <div class="num">91%<small>good</small></div>
            <div class="spark" aria-hidden="true">
              {sparkGreen.map((h) => <i style={`height:${h}%;background:#10B981`}></i>)}
            </div>
          </div>
          <div class="kpi">
            <div class="lab">Outdated packages</div>
            <div class="num">9<small class="bad">+1</small></div>
          </div>
          <div class="kpi">
            <div class="lab">Vulnerabilities</div>
            <div class="num">1<small class="bad">high</small></div>
          </div>
        </div>
        <div class="feed" aria-label="Recent alerts">
          {[
            ['#FDE9E9','✕','jsonwebtoken flagged — CVE-2022-23529','2m'],
            ['#FEF3DC','!','axios 1.4.0 outdated in web-dashboard','18m'],
            ['#E6F7F1','✓','lodash upgraded in web-dashboard','1h'],
            ['#EAF1FE','↑','express 4.21.1 available in api-gateway','2h'],
          ].map(([bg, icon, text, time]) => (
            <div class="fr">
              <span class="ic" style={`background:${bg}`} aria-hidden="true">{icon}</span>
              <span class="tx">{text}</span>
              <span class="tm">{time}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </header>

  <!-- PRODUCT SELECTOR CARDS -->
  <section class="sec alt product-selector">
    <div class="wrap">
      <div class="selector-grid">
        <a href="/core/" class="selector-card core-card">
          <div class="card-icon"><GitBranch strokeWidth={1.5} /></div>
          <h3>Plokr Core</h3>
          <p>Scan dependencies and rank the risk by severity</p>
          <span class="cta-text">Explore Core →</span>
        </a>
        <a href="/integrate" class="selector-card integrate-card">
          <div class="card-icon"><Zap strokeWidth={1.5} /></div>
          <h3>Plokr Integrate</h3>
          <p>REST API, webhooks and data connectors for custom automation</p>
          <span class="cta-text">Explore Integrate →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- UNIFIED INTEGRATIONS STRIP -->
  <div class="logos" id="integrations">
    <div class="wrap">
      <p>Connect your entire engineering stack</p>
      <div class="logorow" aria-label="Supported integrations">
        <span class="lgo"><span class="sq" style="background:#2A6FDB" aria-hidden="true"></span>Jira</span>
        <span class="lgo"><span class="sq" style="background:#1F2328" aria-hidden="true"></span>GitHub</span>
        <span class="lgo"><span class="sq" style="background:#2563EB" aria-hidden="true"></span>Bitbucket</span>
        <span class="lgo"><span class="sq" style="background:#E2432A" aria-hidden="true"></span>GitLab</span>
        <span class="lgo"><span class="sq" style="background:#0B66C3" aria-hidden="true"></span>Trello</span>
      </div>
    </div>
  </div>

  <!-- CONDENSED DUAL SHOWCASES -->
  <section class="sec" id="platform">
    <div class="wrap">
      <!-- Integrate Showcase -->
      <div class="frow rev">
        <div>
          <span class="ftag">API & Integrations</span>
          <h2>Extend Plokr your way.</h2>
          <p class="lead">A REST API and data connectors for custom workflows, so you can move data in and out of Plokr.</p>
          <ul class="checklist">
            {['REST API secured with scoped API keys','Webhooks for outbound events','SQL, S3 and queue connectors','Call any REST endpoint from a pipeline'].map(t => (
              <li><span class="tick" aria-hidden="true">✓</span>{t}</li>
            ))}
          </ul>
          <a class="btn btn-line" href="/integrate" style="margin-top:24px">Explore →</a>
        </div>
        <div class="card" aria-label="Sample dependency audit">
          <div class="ch"><span class="t mono" style="font-size:14px">acme/api-gateway</span><span class="chip">sample data</span></div>
          {[
            ['jsonwebtoken','8.5.1 → 9.0.2','vuln','CVE · high'],
            ['express','4.18.2 → 4.21.1','out','outdated'],
            ['axios','1.4.0 → 1.7.7','out','outdated'],
            ['pg','8.11.3','ok','up to date'],
            ['zod','3.23.8','ok','up to date'],
          ].map(([pkg, ver, status, label]) => (
            <div class="drow">
              <span class="pkg">{pkg}</span>
              <span class="ver">{ver}</span>
              <span class={`tag ${status}`}>{label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- VISUALIZATIONS -->
  <section class="sec viz" id="insights">
    <div class="wrap">
      <div class="sec-head">
        <span class="ftag">Dashboards &amp; insights</span>
        <h2 style="margin-top:16px">See your dependency health at a glance.</h2>
        <p>Plokr scans your repos and shows how many packages are current, outdated or vulnerable. The figures below are sample data.</p>
      </div>
      <div class="vizgrid single">
        <!-- Dependency health donut -->
        <div class="vcard">
          <div class="vh"><span class="t">Dependency health</span><span class="m">142 pkgs</span></div>
          <div class="donutrow">
            <div class="donut" aria-label="91% healthy"><span class="dv">91%</span></div>
            <div class="leg">
              <span class="lk"><i style="background:var(--ok)"></i>129 up to date</span>
              <span class="lk"><i style="background:var(--warn)"></i>9 outdated</span>
              <span class="lk"><i style="background:var(--bad)"></i>4 vulnerable</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- DATA INTEGRITY -->
  <section class="sec">
    <div class="wrap">
      <div class="frow">
        <div>
          <span class="ftag">Data integrity</span>
          <h2>Your data stays yours.</h2>
          <p class="lead">Plokr can't see anything until you connect a tool and approve what it may access. Access is scoped to what you grant and revocable in one click.</p>
          <div class="pillars" style="margin-top:30px">
            {[
              [Lock,'Authorize-first access','Plokr sees nothing until you connect a tool and approve its scopes — no data, ever, without consent.'],
              [Eye,'Reads your repos, writes only results','Plokr reads your repositories. When pull-request decoration is enabled, it posts a comment and a Quality Gate check run on the pull request. It does not change your code or make commits.'],
              [ScanLine,'Granular, revocable scopes','Grant access per project and per repo, and revoke any connection instantly from settings.'],
              [ShieldCheck,'Encrypted','Data is encrypted in transit and at rest.'],
            ].map(([Icon, title, desc]) => (
              <div class="pillar">
                <span class="pi" aria-hidden="true">
                  <Icon strokeWidth={1.8} />
                </span>
                <h4>{title}</h4>
                <p>{desc}</p>
              </div>
            ))}
          </div>
          <a class="btn btn-line" href="/security" style="margin-top:30px">Read about security →</a>
        </div>
        <div class="card" aria-label="Authorization scope example">
          <div class="ch"><span class="t">Authorize Plokr</span><span class="chip">scoped access</span></div>
          {[
            ['#2A6FDB','J','Jira — Payments project','Read projects & issues'],
            ['#1F2328','G','GitHub — acme/api-gateway','Read repo metadata & manifests'],
            ['#0B66C3','T','Trello — Roadmap board','Read boards, lists & cards'],
          ].map(([bg, letter, name, desc]) => (
            <div class="scope">
              <span class="si" style={`background:${bg}`}>{letter}</span>
              <span class="sn"><b>{name}</b><span>{desc}</span></span>
              <span class="ro">SCOPED</span>
            </div>
          ))}
          <div class="permfoot">
            <span>You control access — revoke anytime.</span>
            <span class="stamp">✓ Authorized by you</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="sec dark" id="how">
    <div class="wrap">
      <div class="sec-head left">
        <span class="ftag">How it works</span>
        <h2 style="margin-top:16px">From connect to control in minutes.</h2>
        <p>Zero agents, nothing to install. Authorize your tools and choose what Plokr may access.</p>
      </div>
      <div class="steps">
        {[
          ['01','Connect your stack','Authorize GitHub, Bitbucket or GitLab. Plokr reads your repos, and posts results back to pull requests only when you enable it.'],
          ['02','Plokr scans','We scan your dependencies and rank each finding by severity and exploitability.'],
          ['03','Act before it\'s late','Ranked findings arrive in-app and by webhook, so you can fix the riskiest packages first.'],
        ].map(([n, title, desc]) => (
          <div class="step">
            <span class="n">{n}</span>
            <h3>{title}</h3>
            <p>{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRICING TEASER -->
  <section class="sec soft">
    <div class="wrap">
      <div class="sec-head">
        <span class="ftag">Simple, transparent pricing</span>
        <h2 style="margin-top:16px">Plans for every team size.</h2>
        <p>Two plans, every feature. Start with a 7-day free trial; a card is required and nothing is charged until day 8.</p>
        <div class="pricing-cta" style="margin-top:32px">
          <a class="btn btn-primary btn-lg" href={PLOKR_APP} data-auth="signup">View Pricing</a>
          <a class="btn btn-line btn-lg" href="/pricing">Compare Plans</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING (interactive React island) -->
  <section class="sec" id="pricing">
    <div class="wrap">
      <PricingTiers client:load showLink={true} />
    </div>
  </section>

  <!-- FINAL DUAL CTA BAND -->
  <section class="ctaband">
    <div class="wrap">
      <div class="box">
        <h2>Ready to take control?</h2>
        <p>Find the risk in your dependencies and track the fix. Start your 7-day free trial today.</p>
        <div class="cta">
          <a class="btn btn-primary btn-lg" href={PLOKR_APP} data-auth="signup">Start 7-day free trial</a>
          <a class="btn btn-line btn-lg" href={PLOKR_APP} data-auth="login">Get Started</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
