---
import Layout from '../../layouts/Layout.astro';
import { PLOKR_APP, CTA_INTEGRATE } from '../../lib/constants';
import { Network, Database, GitBranch, Lock, Plug } from 'lucide-react';

const capabilities = [
  [Network, 'REST caller', 'Call any REST endpoint from a pipeline, to read data in or send results out.'],
  [Database, 'SQL reader and writer', 'Read rows from a SQL database into a pipeline, or write results back to one.'],
  [Plug, 'S3 reader and writer', 'Read objects from an S3 bucket, or write pipeline output to one.'],
  [GitBranch, 'Webhooks', 'Receive events with an inbound webhook, or send them out with a webhook caller.'],
  [Network, 'Queue publisher', 'Publish pipeline results to a message queue for other systems to pick up.'],
  [Lock, 'API keys', 'Call the Plokr REST API with scoped API keys that you create and can revoke.'],
];

const inputs = ['REST caller', 'SQL reader', 'S3 reader', 'Webhook (inbound)'];
const outputs = ['REST caller', 'SQL writer', 'S3 writer', 'Webhook caller', 'Queue publisher'];
---

<Layout
  title="Plokr Integrate | Connectors and API"
  description="Plokr Integrate: REST, SQL, S3, webhook and queue connectors, plus a REST API secured with API keys."
  current="integrate"
>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Plokr Integrate",
      "description": "Connectors for REST, SQL, S3, webhooks and queues, plus a REST API secured with API keys.",
      "url": "https://plokr.com/integrate",
      "applicationCategory": "BusinessApplication",
      "offers": {
        "@type": "Offer",
        "price": "29",
        "priceCurrency": "USD"
      },
      "featureList": [
        "REST caller",
        "SQL reader and writer",
        "S3 reader and writer",
        "Webhooks",
        "Queue publisher",
        "API keys"
      ]
    }
  </script>

  <!-- Hero Section -->
  <header class="phero dark" style="padding-bottom:64px">
    <div class="wrap" style="display:grid;grid-template-columns:1fr 1.02fr;gap:54px;align-items:center">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <span>Product</span><span aria-hidden="true">/</span>
          <span style="color:#fff">Integrate</span>
        </nav>
        <span class="eyebrow">Connectors and API</span>
        <h1>Move data in and out of <em>Plokr</em>.</h1>
        <p class="lede">Plokr Integrate gives you REST, SQL, S3, webhook and queue connectors, and a REST API secured with API keys.</p>
        <div class="cta">
          <a class="btn btn-primary btn-lg" href={PLOKR_APP} data-auth="signup">{CTA_INTEGRATE}</a>
          <a class="btn btn-line btn-lg" href="/contact" style="background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.22);color:#fff">Contact us</a>
        </div>
      </div>

      <div class="card" style="background:var(--navy2);border-color:rgba(255,255,255,.1)" aria-label="Connector types">
        <div class="ch" style="border-color:rgba(255,255,255,.08)">
          <span class="t" style="color:#fff">Connector types</span>
        </div>
        <div style="padding:16px;display:grid;grid-template-columns:1fr 1fr;gap:16px;color:rgba(255,255,255,.75);font-size:14px">
          <div>
            <div style="font-weight:600;color:#fff;margin-bottom:8px">Read in</div>
            <ul style="list-style:none;padding:0;margin:0;line-height:1.9">
              {inputs.map(i => <li>{i}</li>)}
            </ul>
          </div>
          <div>
            <div style="font-weight:600;color:#fff;margin-bottom:8px">Send out</div>
            <ul style="list-style:none;padding:0;margin:0;line-height:1.9">
              {outputs.map(o => <li>{o}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Capabilities Grid -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="ftag">Capabilities</span>
        <h2 style="margin-top:16px">What you can connect.</h2>
      </div>
      <div class="grid3">
        {capabilities.map(([Icon, title, desc]) => (
          <div class="feat-card">
            <span class="ic" aria-hidden="true">
              <Icon strokeWidth={1.8} />
            </span>
            <h3>{title}</h3>
            <p>{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="sec ctaband">
    <div class="wrap">
      <div class="box">
        <h2>Ready to connect your data?</h2>
        <p>Start a 7-day free trial and build your first pipeline.</p>
        <div class="cta">
          <a class="btn btn-primary btn-lg" href={PLOKR_APP} data-auth="signup" style="background:#fff;color:#0C1A2B">{CTA_INTEGRATE}</a>
          <a class="btn btn-line btn-lg" href="/contact">Contact us</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
