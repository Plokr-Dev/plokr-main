---
import Layout from '../layouts/Layout.astro';
import PricingTiers from '../components/PricingTiers';
import FAQAccordion from '../components/FAQAccordion';
import { PLOKR_APP } from '../lib/constants';

type FeatureRow = [feature: string, individual: string, team: string];
const groups: [group: string, rows: FeatureRow[]][] = [
  ['Plan', [
    ['Seats', '1', '3-500'],
    ['Credits per month', '1,500', '4,000 per seat'],
  ]],
  ['Monitoring', [
    ['Jira & Trello boards', 'yes', 'yes'],
    ['Repos monitored', 'yes', 'yes'],
    ['Real-time dependency scans', 'yes', 'yes'],
    ['Stale & blocked detection', 'yes', 'yes'],
    ['Trend history', 'yes', 'yes'],
  ]],
  ['Alerts', [
    ['Email digests', 'yes', 'yes'],
    ['Outbound webhooks', 'yes', 'yes'],
    ['Custom alert policies', 'yes', 'yes'],
  ]],
  ['Security & admin', [
    ['SSO / SAML & SCIM', 'yes', 'yes'],
    ['Audit logs', 'yes', 'yes'],
    ['Role-based access', 'yes', 'yes'],
    ['SOC 2 report & DPA', 'yes', 'yes'],
  ]],
  ['Support', [
    ['Priority support', 'yes', 'yes'],
  ]],
] as const;
---

<Layout
  title="Pricing | Plokr"
  description="Two plans, every feature. Individual is $29/month; Team is $79 per seat/month with a 3-seat minimum. Every plan starts with a 7-day free trial."
  current="pricing"
>
  <header class="phero pricing-hero">
    <div class="wrap" style="text-align:center">
      <span class="eyebrow" style="margin:0 auto">Pricing</span>
      <h1 style="margin:20px auto 0">Two plans. Every feature. Pick by team size.</h1>
      <p class="lede" style="margin:22px auto 0">Every plan starts with a 7-day free trial. A card is required, and nothing is charged until day 8.</p>
    </div>
  </header>

  <!-- Tier cards (React for billing toggle) -->
  <section class="sec" style="padding-top:56px">
    <div class="wrap">
      <PricingTiers client:load />
    </div>
  </section>

  <!-- Comparison table (static HTML — great for SEO) -->
  <section class="sec soft">
    <div class="wrap">
      <div class="sec-head"><h2>Every feature in both plans.</h2>
        <p>Only the number of seats and the credits differ.</p></div>
      <table class="ctable">
        <thead>
          <tr>
            <th style="width:40%">Feature</th>
            <th class="c">Individual</th>
            <th class="c">Team</th>
          </tr>
        </thead>
        <tbody>
          {groups.map(([groupName, rows]) => (
            <>
              <tr class="grp"><td colspan="3">{groupName}</td></tr>
              {rows.map(([feature, individual, team]) => (
                <tr>
                  <td>{feature}</td>
                  <td class="c">
                    {individual === 'yes' ? <span class="yes">✓</span> : individual}
                  </td>
                  <td class="c">
                    {team === 'yes' ? <span class="yes">✓</span> : team}
                  </td>
                </tr>
              ))}
            </>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- FAQ (React accordion) -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="ftag">FAQ</span>
        <h2 style="margin-top:16px">Questions, answered.</h2>
      </div>
      <FAQAccordion client:load />
    </div>
  </section>

  <!-- CTA -->
  <section class="sec ctaband" style="padding-top:0">
    <div class="wrap">
      <div class="box">
        <h2>Try every feature for 7 days.</h2>
        <p>A card is required to start; nothing is charged until day 8, and you can cancel any time. Your data stays read-only from the first connection.</p>
        <div class="cta">
          <a class="btn btn-primary btn-lg" href={PLOKR_APP} data-auth="signup">Start 7-day free trial</a>
          <a class="btn btn-line btn-lg" href="/contact">Talk to us</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
