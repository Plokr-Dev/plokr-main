---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Changelog | Plokr"
  description="Release notes for Plokr. None published yet."
  current="changelog"
>
  <header class="phero">
    <div class="wrap">
      <span class="eyebrow">Changelog</span>
      <h1>What's new in Plokr.</h1>
      <p class="lede">Release notes will be posted here as Plokr ships.</p>
    </div>
  </header>

  <section class="sec">
    <div class="wrap-sm">
      <p class="lede" style="color:var(--muted)">There are no release notes yet. We will list every meaningful change here once Plokr is generally available.</p>
    </div>
  </section>
</Layout>
