---
import Layout from '../../layouts/Layout.astro';

const featured = {
  cat: 'Engineering',
  title: 'Why dependency risk is a delivery problem, not just a security one',
  excerpt: 'Outdated and vulnerable packages don\'t just create CVEs — they quietly slow every team that depends on them. Here\'s how we think about ranking risk by impact.',
  author: 'The Plokr team',
  readTime: '6 min',
  slug: 'why-dependency-risk',
};
---

<Layout
  title="Blog | Plokr"
  description="Engineering, security, and product writing from the Plokr team. Notes on observability, dependency risk, and building calm tools for teams that ship."
  current="blog"
>
  <header class="phero">
    <div class="wrap">
      <span class="eyebrow">Blog</span>
      <h1>Writing from the Plokr team.</h1>
      <p class="lede">Notes on engineering observability, dependency risk, and building calm tools for teams that ship.</p>
    </div>
  </header>

  <section class="sec">
    <div class="wrap">
      <!-- Featured post -->
      <a class="feat-post" href={`/blog/${featured.slug}`}>
        <div class="thumb" role="img" aria-hidden="true"></div>
        <div class="pc">
          <span class="cat">{featured.cat}</span>
          <h2>{featured.title}</h2>
          <p>{featured.excerpt}</p>
          <div class="meta">
            {featured.author} · {featured.readTime} read
          </div>
        </div>
      </a>
    </div>
  </section>
</Layout>
